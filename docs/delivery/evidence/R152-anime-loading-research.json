    },
    {
      "hypothesis": "serial detail and chapters amplify wait",
      "status": "code-confirmed-and-successful-chain-observed; no slow-directory UI reproduction",
      "evidence": "DetailPage._load awaits detail then chapters; full _DetailData emitted after both; anime loading already exposes selection button"
    },
    {
      "hypothesis": "cache fallback delays reopening",
      "status": "code-confirmed; device impact not measured",
      "evidence": "DetailPage._loadFromCache called after source failure; requires nonempty chapters"
    },
    {
      "hypothesis": "unrelated source initialization delays anime readiness",
      "status": "code-risk-only-not-measured",
      "evidence": "SourceRegistry.load awaits enabled JS initialization serially; consumers await shared sourcesProvider.future"
    }
